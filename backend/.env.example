PORT=8096
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# SMTP Configuration
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Translate API
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# Redis & Currency Converter
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6
BASE_CURRENCY=USD

# ==============================================================================
# Razorpay Payment Gateway Credentials
# NOTE: All secret credentials must remain strictly on the backend!
# NEVER expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to the frontend.
# Supports Test Mode (rzp_test_...) and Live Mode (rzp_live_...)
# ==============================================================================
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# Stripe & Zoom Credentials
STRIPE_SECRET_KEY=sk_test_placeholder_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_stripe_webhook_secret
ZOOM_ACCOUNT_ID=placeholder_zoom_account_id
ZOOM_CLIENT_ID=placeholder_zoom_client_id
ZOOM_CLIENT_SECRET=placeholder_zoom_client_secret
ZOOM_USER_ID=me
ZOOM_WEBHOOK_SECRET=placeholder_zoom_webhook_secret

# AWS S3 Storage
AWS_ACCESS_KEY_ID=placeholder_aws_access_key_id
AWS_SECRET_ACCESS_KEY=placeholder_aws_secret_access_key
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET_NAME=edunyte-recordings
RECORDING_STORAGE_PROVIDER=s3

NODE_ENV=development

